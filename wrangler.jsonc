{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leah-maelane-site",
  "compatibility_date": "2026-04-22",
  "routes": [
    {
      "pattern": "leahmaelane.com",
      "custom_domain": true,
      "zone_name": "leahmaelane.com"
    },
    {
      "pattern": "www.leahmaelane.com",
      "custom_domain": true,
      "zone_name": "leahmaelane.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
