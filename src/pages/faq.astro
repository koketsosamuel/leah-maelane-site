---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    question: 'What types of modelling bookings are available?',
    answer: 'Leah is available for editorial shoots, commercial campaigns, runway shows, beauty work, lookbooks, cultural fashion projects, and selected brand collaborations.',
  },
  {
    question: 'Where is Leah based?',
    answer: 'Leah is based in Pretoria, South Africa, and can travel for suitable campaigns, shows, and productions.',
  },
  {
    question: 'How do I request rates or availability?',
    answer: 'Send the project date, location, usage, creative brief, and production contact through the contact page or by email. Confirmed rates depend on scope, usage, travel, and timing.',
  },
  {
    question: 'Can brands book Leah for commercial campaigns?',
    answer: 'Yes. Commercial and advertising enquiries are welcome, especially projects with a clear brief, usage details, production schedule, and booking window.',
  },
  {
    question: 'Are portfolio images available for reuse?',
    answer: 'No. Portfolio images remain protected by their respective copyright and usage agreements. Please request permission before reposting, publishing, or using any image commercially.',
  },
];
---

<BaseLayout title="FAQ | Leah Maelane Modelling Bookings" description="Answers to common questions about booking Leah Maelane for editorial, commercial, beauty, runway, and fashion projects.">
  <Navigation activeLink="FAQ" />
  <section class="page-shell">
    <p class="eyebrow">FAQ</p>
    <h1>Booking Questions</h1>
    <div class="faq-list">
      {faqs.map((item) => (
        <article class="faq-item">
          <h2>{item.question}</h2>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>
  <Footer variant="simple" />
</BaseLayout>

<style>
  .page-shell {
    max-width: 960px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--color-accent);
  }

  h1 {
    margin-top: 12px;
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: normal;
    color: var(--color-text-dark);
  }

  .faq-list {
    display: grid;
    gap: 20px;
    margin-top: 48px;
  }

  .faq-item {
    border-top: 1px solid var(--color-bg-alt);
    padding-top: 24px;
  }

  .faq-item h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: normal;
    color: var(--color-text-dark);
  }

  .faq-item p {
    margin-top: 10px;
    color: var(--color-text-muted);
  }
</style>
