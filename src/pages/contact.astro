---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Book Leah Maelane | Modelling Enquiries & Collaborations" description="Book Leah Maelane for your next editorial, commercial, or runway project. Get in touch for worldwide modelling bookings and collaborations." ogImage="/images/portrait-bw-elegant.jpg">
  <Navigation activeLink="CONTACT" />
  <div class="nav-divider"></div>

  <section class="contact-main">
    <div class="contact-left">
      <h1 class="contact-heading">Let's Create<br>Something Beautiful</h1>
      <p class="contact-subtitle">
        Whether it's a campaign, editorial, runway show, or cultural celebration — I'd love to hear from you.
      </p>

      <div class="dot-accent">
        <span class="dot gold"></span>
        <span class="dot copper"></span>
        <span class="dot gold"></span>
        <span class="dot red"></span>
        <span class="dot gold"></span>
      </div>

      <div class="gold-line"></div>

      <form class="booking-form" id="contact-form" novalidate>
        <div class="field-grid">
          <label class="field" for="name">
            <span>Full Name</span>
            <input id="name" name="name" type="text" autocomplete="name" />
          </label>
          <label class="field" for="phone">
            <span>Phone Number</span>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </label>
        </div>

        <label class="field" for="email">
          <span>Email Address</span>
          <input id="email" name="email" type="email" autocomplete="email" />
        </label>

        <label class="field" for="subject">
          <span>Booking Type</span>
          <select id="subject" name="subject">
            <option value="">Select a booking type</option>
            <option value="Editorial booking">Editorial booking</option>
            <option value="Commercial campaign">Commercial campaign</option>
            <option value="Runway show">Runway show</option>
            <option value="Beauty or lookbook shoot">Beauty or lookbook shoot</option>
            <option value="Brand collaboration">Brand collaboration</option>
            <option value="General enquiry">General enquiry</option>
          </select>
        </label>

        <label class="field" for="message">
          <span>Project Details</span>
          <textarea id="message" name="message" rows="5" required placeholder="Share the date, location, usage, and creative brief."></textarea>
        </label>

        <p id="form-success" class="form-message success" hidden>Your message has been sent successfully. We will be in touch soon.</p>
        <p id="form-error" class="form-message error" hidden>Please add your message and at least one contact detail.</p>

        <button id="submit-btn" type="submit" class="submit-button">SEND ENQUIRY</button>
      </form>

      <!-- Contact Info -->
      <div class="contact-info">
        <div class="info-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <a href="mailto:leahmaelane14@gmail.com">leahmaelane14@gmail.com</a>
        </div>
        <div class="info-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:+27848066821">084 806 6821</a>
        </div>
        <div class="info-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Pretoria, South Africa</span>
        </div>
      </div>

      <!-- Social Links -->
      <div class="social-links">
        <span class="social-label">FOLLOW THE JOURNEY</span>
        <div class="social-divider"></div>
        <a href="https://www.instagram.com/leahmaelane" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
        </a>
        <a href="https://www.facebook.com/share/1AEHJSNtki/?mibextid=wwXIfr" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>
    </div>

    <div class="contact-image">
      <img src="/images/contact-beauty-portrait.jpg" alt="Leah Maelane beauty portrait with makeup brushes" width="1000" height="1250" loading="lazy" />
    </div>
  </section>

  <Footer variant="simple" />
</BaseLayout>

<style>
  .nav-divider {
    width: 100%;
    height: 1px;
    background: var(--color-bg-alt);
  }

  .contact-main {
    display: flex;
    gap: 80px;
    padding: 80px;
  }

  .contact-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.3vw, 48px);
    font-weight: normal;
    line-height: 1.15;
    color: var(--color-text-dark);
  }

  .contact-subtitle {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .dot-accent {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot.gold { background: var(--color-accent); }
  .dot.copper { background: var(--color-accent-alt); }
  .dot.red { background: #C4302B; }

  .gold-line {
    width: 60px;
    height: 2px;
    background: var(--color-accent);
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(242, 236, 228, 0.65);
    border: 1px solid rgba(200, 152, 60, 0.24);
    padding: 24px;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field span {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid rgba(122, 100, 88, 0.28);
    background: rgba(250, 246, 240, 0.88);
    color: var(--color-text-dark);
    padding: 12px 14px;
    font-size: 15px;
    border-radius: 2px;
  }

  .field textarea {
    min-height: 132px;
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(200, 152, 60, 0.14);
  }

  .submit-button {
    align-self: flex-start;
    background: var(--color-text-dark);
    color: var(--color-light);
    padding: 13px 24px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    transition: background 0.3s, opacity 0.3s;
  }

  .submit-button:hover {
    background: var(--color-accent);
  }

  .submit-button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .form-message {
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.5;
  }

  .form-message.success {
    background: rgba(67, 126, 86, 0.12);
    color: #2E6D42;
  }

  .form-message.error {
    background: rgba(196, 48, 43, 0.1);
    color: #9B2925;
  }

  /* Contact Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--color-bg-alt);
    padding: 20px 24px;
    border-radius: 4px;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--color-text-dark);
  }

  .info-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .info-row a {
    color: var(--color-text-dark);
    transition: color 0.3s;
  }

  .info-row a:hover {
    color: var(--color-accent);
  }

  /* Social */
  .social-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .social-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--color-text-muted);
  }

  .social-divider {
    width: 40px;
    height: 1px;
    background: var(--color-accent);
  }

  .social-links a {
    color: var(--color-text-muted);
    transition: color 0.3s;
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  /* Right Image */
  .contact-image {
    width: 500px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .contact-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 1024px) {
    .contact-main {
      padding: 40px;
      gap: 40px;
    }

    .contact-image {
      width: 380px;
    }
  }

  @media (max-width: 768px) {
    .contact-main {
      flex-direction: column-reverse;
      padding: 24px;
    }

    .field-grid {
      grid-template-columns: 1fr;
    }

    .contact-image {
      width: 100%;
      height: 400px;
    }
  }
</style>

<script>
  const contactEndpoint = 'https://hub.brightsync.co.za/api/contact-submissions';

  document.getElementById('contact-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const form = event.currentTarget as HTMLFormElement;
    const submitButton = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const success = document.getElementById('form-success');
    const error = document.getElementById('form-error');
    const formData = new FormData(form);

    const name = String(formData.get('name') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const phone = String(formData.get('phone') || '').trim();
    const subject = String(formData.get('subject') || '').trim();
    const message = String(formData.get('message') || '').trim();

    if (success) success.hidden = true;
    if (error) error.hidden = true;

    if (!message || (!name && !email && !phone)) {
      if (error) {
        error.textContent = 'Please add your message and at least one contact detail.';
        error.hidden = false;
      }
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'SENDING...';
    }

    try {
      const response = await fetch(contactEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          Subject: subject || 'Leah Maelane website enquiry',
          name,
          phone,
          email,
          message,
        }),
      });

      if (!response.ok) {
        throw new Error('Contact form submission failed');
      }

      if (success) success.hidden = false;
      form.reset();
    } catch {
      if (error) {
        error.textContent = 'Something went wrong. Please try again or contact Leah directly.';
        error.hidden = false;
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'SEND ENQUIRY';
      }
    }
  });
</script>
